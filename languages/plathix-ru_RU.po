msgstr "1 файл перемещён"

msgid "files moved"
msgstr "файлов перемещено"

msgid "Move the selected folders to Trash? You can restore them later."
msgstr "Переместить выбранные папки в корзину? Их можно будет восстановить."

msgid "Files won't be deleted — depending on your Trash settings, they either move with the folders or become unassigned."
msgstr "Файлы не будут удалены — в зависимости от настроек корзины, они либо переместятся вместе с папками, либо станут неприкреплёнными."

msgid "Some selected folders contain subfolders. Choose how to handle them:"
msgstr "Некоторые выбранные папки содержат подпапки. Выберите, как с ними поступить:"

msgid "Move only selected, keep subfolders"
msgstr "Переместить только выбранные, оставить вложенные"

msgid "Move selected and all subfolders to Trash"
msgstr "Переместить выбранные и все вложенные папки в корзину"

msgid "Create folder"
msgstr "Создать папку"

msgid "Rename folder"
msgstr "Переименовать папку"

