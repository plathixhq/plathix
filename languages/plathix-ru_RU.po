msgstr "Выбрать папку"

msgid "File"
msgstr "Файл"

#. translators: aria-подпись иконки «файлы» в счётчике корзины (доступность).
msgid "Files"
msgstr "Файлы"

msgid "Uncategorized"
msgstr "Несортированные"

msgid "Trash"
msgstr "Корзина"

msgid "Cannot create subfolders inside Uncategorized."
msgstr "Нельзя создавать подпапки внутри Несортированных."

msgid "Maximum folder nesting depth reached."
msgstr "Достигнута максимальная глубина вложенности папок."

