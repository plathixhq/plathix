#, php-format
msgid "No folders yet. Create your first folder to organize your %s."
msgstr "Папок ещё нет. Создайте первую папку для организации %s."

msgid "No folders found."
msgstr "Папки не найдены."

msgid "Favorites"
msgstr "Избранное"

msgid "Add to favorites"
msgstr "Добавить в избранное"

msgid "Remove from favorites"
msgstr "Убрать из избранного"

msgid "Failed to save favorites."
msgstr "Не удалось сохранить избранное."

msgid "Unable to refresh nonce."
msgstr "Не удалось обновить nonce."

msgid "Request failed."
msgstr "Запрос завершился ошибкой."

msgid "file uploaded"
msgstr "файл загружен"

msgid "files uploaded"
msgstr "файлов загружено"

msgid "Upload is still running. The view will return to the upload folder when it finishes."
msgstr "Загрузка ещё выполняется. После завершения откроется папка загрузки."

msgid "Upload is still running in the selected folder. The view will return there when it finishes."
msgstr "Загрузка ещё выполняется в выбранной папке. После завершения вернётесь туда."

msgid "Uploads are still in progress. Leaving now may interrupt them."
msgstr "Загрузка ещё идёт. Уход со страницы может прервать её."

msgid "Error"
msgstr "Ошибка"

msgid "File replaced successfully."
msgstr "Файл успешно заменён."

msgid "File replaced, but some cleanup steps need manual review."
msgstr "Файл заменён, но некоторые шаги очистки требуют ручной проверки."

msgid "Replace failed."
msgstr "Замена не удалась."

msgid "Replacing…"
msgstr "Замена…"

msgid "File replaced, but the preview could not be refreshed. Reload the page to see the new file."
msgstr "Файл заменён, но превью не удалось обновить. Обновите страницу, чтобы увидеть новый файл."

msgid "The file may have been replaced, but the server response could not be confirmed. Reload the page to check."
msgstr "Файл мог быть заменён, но подтвердить ответ сервера не удалось. Обновите страницу, чтобы проверить."

#. translators: 1: image width in pixels, 2: image height in pixels.
#, php-format
msgid "%1$s by %2$s pixels"
msgstr "%1$s на %2$s пикселей"

msgid "The server is blocking REST write requests. Contact your hosting."
msgstr "Сервер блокирует REST-запросы на запись. Обратитесь к хостингу."

msgid "The server is corrupting REST responses (both /wp-json/ and rest_route returned invalid data). Contact your hosting."
msgstr "Сервер искажает ответы REST (оба endpoint /wp-json/ и rest_route вернули невалидные данные). Обратитесь к хостингу."

msgid "The server accepted the request, but the response could not be read. Refreshing to confirm the result."
msgstr "Сервер принял запрос, но ответ не удалось прочитать. Обновляем данные, чтобы подтвердить результат."

msgid "Upload failed."
msgstr "Загрузка не удалась."

