msgstr "Неверный ID папки."

msgid "Unable to delete folder."
msgstr "Не удалось удалить папку."

msgid "WP Cron / Action Scheduler"
msgstr "WP Cron / Action Scheduler"

msgid "Enabled"
msgstr "Включено"

msgid "DISABLE_WP_CRON, Action Scheduler idle (nothing scheduled)"
msgstr "DISABLE_WP_CRON, Action Scheduler простаивает (ничего не запланировано)"

msgid "DISABLE_WP_CRON but Action Scheduler active"
msgstr "DISABLE_WP_CRON, но Action Scheduler активен"

msgid "WP-Cron disabled, Action Scheduler stalled — ZIP/import jobs may not run"
msgstr "WP-Cron отключён, Action Scheduler остановлен — задания ZIP/импорта могут не выполняться"

msgid "Temp Dir Writable"
msgstr "Доступность временной папки"

msgid "Writable"
msgstr "Доступна для записи"

