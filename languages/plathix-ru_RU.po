msgstr "Папку Несортированные нельзя переименовать."

msgid "This folder was removed. Please refresh the folder tree and try again."
msgstr "Эта папка была удалена. Обновите дерево папок и попробуйте снова."

msgid "Cannot move a folder into one of its own subfolders."
msgstr "Нельзя переместить папку в одну из её подпапок."

msgid "Cannot move a folder into a folder that is in Trash."
msgstr "Нельзя переместить папку в папку, которая находится в Корзине."

msgid "Folder name cannot be empty."
msgstr "Название папки не может быть пустым."

msgid "Folder name contains control or bidirectional characters."
msgstr "Имя папки содержит управляющие или двунаправленные символы."

msgid "Folder name is too long."
msgstr "Название папки слишком длинное."

msgid "Invalid taxonomy."
msgstr "Неверная таксономия."

msgid "A folder cannot be moved to itself."
msgstr "Папку нельзя переместить в саму себя."

msgid "Attachment ID must be positive."
msgstr "ID вложения должен быть положительным."

msgid "A trash operation is already in progress for this attachment."
msgstr "Для этого вложения уже выполняется операция перемещения в корзину."

msgid "Restore"
msgstr "Восстановить"

msgid "Delete permanently"
msgstr "Удалить навсегда"

msgid "Folder"
msgstr "Папка"

msgid "Insufficient permissions."
msgstr "Недостаточно прав."

msgid "Folder no longer exists."
msgstr "Папка больше не существует."

msgid "Not logged in."
msgstr "Вы не авторизованы."

msgid "Too many requests."
msgstr "Слишком много запросов."

msgid "No folders selected."
msgstr "Папки не выбраны."

msgid "You are creating folders too quickly. Please wait about a minute and try again."
msgstr "Вы создаёте папки слишком быстро. Подождите примерно минуту и попробуйте снова."

msgid "You are changing folders too quickly. Please wait about a minute and try again."
msgstr "Вы изменяете папки слишком быстро. Подождите примерно минуту и попробуйте снова."

msgid "You are deleting folders too quickly. Please wait about a minute and try again."
msgstr "Вы удаляете папки слишком быстро. Подождите примерно минуту и попробуйте снова."

msgid "Folder is not in Trash or no longer exists."
msgstr "Папка не в корзине или больше не существует."

msgid "Trash is busy, try again."
msgstr "Корзина занята, попробуйте ещё раз."

msgid "Folder is not in Trash."
msgstr "Папка не в корзине."

msgid "Media trash is only available for attachments."
msgstr "Корзина медиатеки доступна только для вложений."

msgid "Media restore is only available for attachments."
msgstr "Восстановление медиафайлов доступно только для вложений."

msgid "Service tokens cannot modify personal preferences."
msgstr "Сервисные токены не могут изменять личные настройки."

msgid "Media replace is only available for attachments."
msgstr "Замена медиафайлов доступна только для вложений."

msgid "Attachment ID is required."
msgstr "Необходимо указать ID вложения."

msgid "Replacement file is required."
msgstr "Необходимо загрузить файл для замены."

msgid "File replaced successfully"
msgstr "Файл успешно заменён"

