{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "maxNodeModuleJsDepth": 0,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "resources/js/sidebar/**/*.js",
    "resources/js/sidebar/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "resources/js/sidebar/**/__tests__/**",
    "resources/js/sidebar/favorites/**"
  ]
}
